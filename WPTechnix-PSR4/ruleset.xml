<?xml version="1.0" ?>
<ruleset
    name="WPTechnix-PSR4"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpcodesniffer.com/phpcs.xsd"
>

    <description>
        PSR-4 naming standard for WordPress projects. Includes the WPTechnix base
        automatically and enables PSR-4 file naming (Plugin.php instead of
        class-plugin.php), dropping the redundant @package tag.
    </description>

    <!-- The base this standard is built on. -->
    <rule ref="WPTechnix" />

    <!-- PSR-4 uses Plugin.php, not class-plugin.php. -->
    <rule ref="WordPress.Files.FileName">
        <severity>0</severity>
    </rule>

    <!-- @package is redundant under PSR-4 namespaces. -->
    <rule ref="Squiz.Commenting.FileComment.MissingPackageTag">
        <severity>0</severity>
    </rule>

</ruleset>
